@startuml
title Hình 2.7. Trình tự cộng tác của nhóm UC06\nQuản lý giỏ hàng

hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ParticipantBackgroundColor #EDF3FA
  ParticipantBorderColor #40546A
  LifeLineBorderColor #8795A5
  ArrowColor #40546A
}

participant "Người sử dụng" as ND
participant "Lớp biên\nUI" as UI
participant "Lớp điều khiển\nController" as C
participant "GioHang /\nSKU /\nTonKho" as E

ND -> UI : 1. Thêm / sửa / xóa SKU
UI -> C : 2. Gửi yêu cầu cập nhật giỏ
C -> E : 3. Đọc SKU và kiểm tra số lượng
E --> C : 4. Lưu và trả giỏ mới
C --> UI : 5. Trả tạm tính / cảnh báo
UI --> ND : 6. Hiển thị giỏ đã cập nhật
@enduml
